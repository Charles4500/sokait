# Copy to .env and fill in ONE backend. Leave everything empty for the offline client.

# Groq (free, no card): API key from https://console.groq.com/keys
# Any OpenAI-compatible provider works the same way (e.g. Gemini via AI Studio).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_REASONING_EFFORT=low
# Per-role model lists fail over in order when one is rate-limited (quotas are per model).
# Bigger model first where language quality matters.
OPENAI_MODEL_ANALYST=openai/gpt-oss-20b,openai/gpt-oss-120b
OPENAI_MODEL_NARRATOR=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENAI_MODEL_QA=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENAI_MODEL_RECAP=openai/gpt-oss-120b,openai/gpt-oss-20b

# Microsoft Foundry (needs an Azure subscription)
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL=

# Shared with the web app
# AGENTS_TOKEN=
# MOMENT_BUDGET_S=4
# Token budget (defaults fit two Groq free-tier models): AI goes to bigger moments as it fills.
# TOKENS_PER_MINUTE=14000
# TOKENS_PER_DAY=350000

# Hugging Face (free, no card): only for generating player portraits once (scripts).
# HF_TOKEN=

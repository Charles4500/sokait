# Copy to .env and fill in ONE backend. Leave everything empty for the offline client.

# GitHub Models (free with a GitHub account): fine-grained token with "Models: read".
OPENAI_API_KEY=
OPENAI_BASE_URL=https://models.github.ai/inference
OPENAI_MODEL=openai/gpt-4.1-mini

# Microsoft Foundry (needs an Azure subscription)
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL=

# Shared with the web app
# AGENTS_TOKEN=
# MOMENT_BUDGET_S=2.5

# Copy to .env and fill in ONE backend. Leave everything empty for the offline client.

# Groq (free, no card): API key from https://console.groq.com/keys
# Any OpenAI-compatible provider works the same way (e.g. Gemini via AI Studio).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_REASONING_EFFORT=low
# Bigger model where language quality matters; separate Groq rate-limit bucket too.
OPENAI_MODEL_NARRATOR=openai/gpt-oss-120b
OPENAI_MODEL_QA=openai/gpt-oss-120b
OPENAI_MODEL_RECAP=openai/gpt-oss-120b

# Microsoft Foundry (needs an Azure subscription)
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL=

# Shared with the web app
# AGENTS_TOKEN=
# MOMENT_BUDGET_S=4
